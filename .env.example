# Shared (both apps) — InsForge until later cutover tickets
NEXT_PUBLIC_INSFORGE_URL=https://your-app.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Neon Postgres — owned by `@dtm/database` (`packages/database/src/config/env.ts`).
# Required by dashboard, landing, and `pnpm db:push` / tests.
# One connection for local work. Do not add a second Neon role here.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Dashboard only
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001
INSFORGE_JWT_SECRET=

# Dashboard seed only (`pnpm --filter @dtm/dashboard db:seed`) — not needed for deploy
DEV_SEED_ADMIN_EMAIL=
DEV_SEED_ADMIN_PASSWORD=
DEV_SEED_ADMIN_NAME=Admin
