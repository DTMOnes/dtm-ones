# Shared (both apps)
NEXT_PUBLIC_INSFORGE_URL=https://your-app.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Dashboard only — InsForge Postgres from `npx @insforge/cli db connection-string`
DATABASE_URL=postgresql://user:password@host:5432/insforge?sslmode=require
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001
INSFORGE_JWT_SECRET=

# Dashboard seed only (`pnpm --filter @dtm/dashboard db:seed`) — not needed for deploy
DEV_SEED_ADMIN_EMAIL=
DEV_SEED_ADMIN_PASSWORD=
DEV_SEED_ADMIN_NAME=Admin
