{
  "name": "dtm-ones",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "db:push": "turbo run db:push --filter @dtm/db",
    "db:studio": "turbo run db:studio --filter @dtm/db",
    "db:seed": "pnpm --filter @dtm/dashboard db:seed"
  },
  "devDependencies": {
    "@dtm/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "turbo": "^2.5.4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.5.0"
}
