# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (all workspaces — not only repo root)
node_modules/
.venv/
.pnp
.pnp.*
.pnpm-store/

# yarn (if ever used)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# turbo
.turbo/

# next.js
.next/
out/
next-env.d.ts

# production / package build outputs
dist/
build/
*.tsbuildinfo

# testing
coverage/
playwright-report/
test-results/

# env (keep .env.example committable)
.env
.env.*
!.env.example

# vercel
.vercel

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# misc / OS / editors
.DS_Store
Thumbs.db
*.pem
.eslintcache
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# cursor / agent tooling
.cursor
.agents/**
skills-lock.json
