venv/
env/
.pnp
.pnp.*
.pnpm-store/

# yarn (if ever used)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# turbo
.turbo/

# next.js
.next/
out/
next-env.d.ts

# production / package build outputs
dist/
build/
*.tsbuildinfo

# python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.coverage
coverage.xml
htmlcov/
.eggs/
*.egg-info/
pip-wheel-metadata/

# testing
coverage/
playwright-report/
test-results/

# env (keep .env.example committable)
.env
.env.*
!.env.example
!.env.test.example

# vercel
.vercel

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

