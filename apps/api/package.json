{
  "name": "@dtm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn main:app --reload --host 0.0.0.0 --port 8000 --app-dir src",
    "start": "uv run uvicorn main:app --host 0.0.0.0 --port 8000 --app-dir src",
    "lint": "uv run ruff check .",
    "format": "uv run ruff format .",
    "test": "uv run pytest",
    "test:e2e": "uv run --env-file ../../.env.test pytest",
    "db:migrate": "uv run alembic upgrade head",
    "db:seed": "uv run python src/seed_dev_admin.py"
  }
}
