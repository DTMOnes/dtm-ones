{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", ".env.*"],
  "globalEnv": [
    "APP_ENV",
    "DATABASE_URL",
    "API_URL",
    "NEXT_PUBLIC_API_URL",
    "AUTH_SECRET_KEY",
    "AUTH_ACCESS_TOKEN_EXPIRE_MINUTES",
    "AUTH_REFRESH_TOKEN_EXPIRE_DAYS",
    "AUTH_ALGORITHM",
    "BLOB_READ_WRITE_TOKEN",
    "CORS_ORIGINS",
    "SKIP_ENV_VALIDATION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"],
      "env": ["TEST_DATABASE_URL"]
    },
    "db:seed": {
      "cache": false,
      "env": [
        "DEV_SEED_ADMIN_EMAIL",
        "DEV_SEED_ADMIN_PASSWORD",
        "DEV_SEED_ADMIN_NAME"
      ]
    }
  }
}
