{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", ".env.*"],
  "globalEnv": [
    "DATABASE_URL",
    "SKIP_ENV_VALIDATION",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "NEXT_PUBLIC_BETTER_AUTH_URL",
    "INSFORGE_JWT_SECRET",
    "NEXT_PUBLIC_INSFORGE_URL",
    "NEXT_PUBLIC_INSFORGE_ANON_KEY",
    "DEV_SEED_ADMIN_EMAIL",
    "DEV_SEED_ADMIN_PASSWORD",
    "DEV_SEED_ADMIN_NAME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"],
      "env": ["TEST_DATABASE_URL"]
    },
    "db:seed": {
      "cache": false,
      "env": [
        "DEV_SEED_ADMIN_EMAIL",
        "DEV_SEED_ADMIN_PASSWORD",
        "DEV_SEED_ADMIN_NAME"
      ]
    }
  }
}
